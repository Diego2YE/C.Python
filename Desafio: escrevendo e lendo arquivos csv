alunos = [
    ("Ana", 8.5),
    ("Bruno", 6.0),
    ("Carlos", 7.2),
    ("Daniela", 9.0),
    ("Eduardo", 5.5)
]
with open("alunos.csv", "w", encoding="utf-8") as arquivo:
    for nome, nota in alunos:
        arquivo.write(f"{nome},{nota}\n")
with open("alunos.csv", "r", encoding="utf-8") as arquivo:
    for linha in arquivo:
        nome, nota = linha.strip().split(",")
        nota = float(nota)

        if nota >= 7.0:
            print(f"Aluno: {nome} | Nota: {nota}")
