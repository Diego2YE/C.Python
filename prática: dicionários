    quadrados[numero] = numero**2
print(quadrados)

if 'nome' in pessoa:
    print("\nA chave 'nome' existe no dicionário.")
else:
    print("\nA chave 'nome' não existe no dicionário.")

frase = "o jogador venceu a partida e o jogador comemorou a vitória"
palavras = frase.split()
frequencia = {}
for palavra in palavras:
    if palavra in frequencia:
        frequencia[palavra] += 1
    else:
        frequencia[palavra] = 1
print(f'\n{frequencia}')
